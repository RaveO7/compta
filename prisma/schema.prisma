// Schéma de la base de données — comptabilité ventes par boutique
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Boutique {
  id        Int      @id @default(autoincrement())
  nom       String
  contact   String?
  adresse   String?
  notes     String?
  // Boutique fermée / plus active : masquée du suivi mensuel, historique conservé
  archivee  Boolean  @default(false)
  // Frais de la boutique (cumulables) : loyer fixe par mois et/ou commission en % du CA
  loyerMensuel Float @default(0)
  commission   Float @default(0) // en %, ex : 30 pour 30 %
  // Conditions selon le CA mensuel : [{ seuil, valeur }], ex. 10 % dès 100 € de ventes
  paliersLoyer          Json    @default("[]")
  paliersCommission     Json    @default("[]")
  // Commission par tranches (chaque taux sur sa part de CA) plutôt que sur tout le CA
  commissionParTranches Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prix       Prix[]
  entrees    Entree[]
  fraisEnvoi FraisEnvoi[]
}

model Article {
  id          Int      @id @default(autoincrement())
  nom         String
  reference   String?
  categorie   String? // ex : Print, Lino, Stickers…
  prixDefaut  Float    @default(0)
  // Frais de fabrication par unité (achat de matériel), déduits à chaque vente
  coutUnitaire Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prix    Prix[]
  entrees Entree[]

  @@index([categorie])
}

// Prix d'un article spécifique à une boutique
model Prix {
  id         Int      @id @default(autoincrement())
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId  Int
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  boutiqueId Int
  valeur     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([articleId, boutiqueId])
}

// Suivi mensuel : ce qui a été envoyé et vendu, par boutique, par article, par mois
model Entree {
  id         Int      @id @default(autoincrement())
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  boutiqueId Int
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId  Int
  mois       String // format "YYYY-MM"
  envoye     Int      @default(0)
  vendu      Int      @default(0)
  prixUnitaire Float  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([boutiqueId, articleId, mois])
  @@index([mois])
}

// Frais d'envoi vers une boutique (colis), saisis les mois où il y a un envoi
model FraisEnvoi {
  id         Int      @id @default(autoincrement())
  boutique   Boutique @relation(fields: [boutiqueId], references: [id], onDelete: Cascade)
  boutiqueId Int
  mois       String // format "YYYY-MM"
  montant    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([boutiqueId, mois])
}
